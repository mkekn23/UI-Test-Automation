<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="tbcbank.ge ui testing" >

    <test name="Desktop Tests"
          group-by-instances="true"
          parallel="instances"
          thread-count="2">
        <parameter name="deviceProfile" value="desktop"/>
        <classes>
            <class name="tests.LocationsFilterTest"/>
            <class name="tests.LocationsSearchTest"/>
            <class name="tests.CurrencyTest"/>
            <class name="tests.LoansFactory"/>
            <class name="tests.MoneyTransfersFactory"/>
        </classes>
    </test>

    <test name="Mobile Tests"
          group-by-instances="true"
          parallel="instances"
          thread-count="2">
        <parameter name="deviceProfile" value="mobile"/>
        <classes>
            <class name="tests.LocationsFilterTest"/>
            <class name="tests.LocationsSearchTest"/>
            <class name="tests.CurrencyTest"/>
            <class name="tests.LoansFactory"/>
            <class name="tests.MoneyTransfersFactory"/>
        </classes>
    </test>

</suite>